-- CCLights2 tutorial. Lays itself out in real screen pixels (like a terminal program) so it
-- reads the same on a small wall and a big one: text is never shrunk, long lines wrap.
gpu = peripheral.find("GPU")

if not gpu then
	error("Could not find a GPU connected to the computer!",0)
end

local w, h = gpu.getSize(0)
local big = w >= 200 and h >= 100   -- room for 2x titles
local sectex

-- word-wraps text to the screen width; returns a list of lines
local function wrap(text, maxWidth)
	maxWidth = maxWidth or w
	local lines, line = {}, ""
	for word in text:gmatch("%S+") do
		-- a single word wider than the screen is broken between characters
		while gpu.getTextWidth(word) > maxWidth and #word > 1 do
			local n = #word - 1
			while n > 1 and gpu.getTextWidth(word:sub(1, n)) > maxWidth do n = n - 1 end
			if line ~= "" then lines[#lines + 1] = line; line = "" end
			lines[#lines + 1] = word:sub(1, n)
			word = word:sub(n + 1)
		end
		local candidate = line == "" and word or (line .. " " .. word)
		if gpu.getTextWidth(candidate) <= maxWidth or line == "" then
			line = candidate
		else
			lines[#lines + 1] = line
			line = word
		end
	end
	if line ~= "" then lines[#lines + 1] = line end
	return lines
end

-- wait for a click, returns x, y in screen pixels
local function click()
	local _, b, x, y = os.pullEvent("monitor_up")
	return x, y
end

function fadeDouble(v,x,y,r,g,b)
	x, y = x or 0, y or 0
	r,g,b = r or 0,g or 0,b or 0
	local scale = big and 2 or 1
	gpu.push()
	gpu.scale(scale,scale)
	for i=1,16 do
		gpu.setColor(r,g,b,32)
		gpu.drawText(v,x,y)
		sleep(0)
	end
	gpu.setColor(r,g,b)
	gpu.drawText(v,x,y)
	gpu.pop()
	return 8 * scale
end

-- draws a list of lines with a short fade-in; returns the height used
local function fadeLines(lines,x,y,r,g,b)
	for i=1,4 do
		gpu.setColor(r,g,b,64)
		for n, line in ipairs(lines) do gpu.drawText(line,x,y + (n - 1) * 8) end
		sleep(0)
	end
	gpu.setColor(r,g,b)
	for n, line in ipairs(lines) do gpu.drawText(line,x,y + (n - 1) * 8) end
	return #lines * 8
end

-- draws (wrapped) text with a short fade-in; returns the height used
function fade(v,x,y,r,g,b)
	x, y = x or 0, y or 0
	r,g,b = r or 0,g or 0,b or 0
	return fadeLines(wrap(v, w - x),x,y,r,g,b)
end

local ny = 0
-- screen full: ask for a click, then start a new page
local function newPage()
	fade("Click to continue", 0, math.min(ny, h - 8), 128, 128, 128)
	os.pullEvent("monitor_up")
	fadeScreen()
end
-- draws a paragraph below the previous one, continuing on new pages when it does not fit
function fadeNext(v,r,g,b)
	r,g,b = r or 0,g or 0,b or 0
	local lines = wrap(v, w)
	local first = 1
	while first <= #lines do
		-- the bottom row is kept free for the "Click to continue" prompt
		local room = math.floor((h - ny) / 8) - 1
		local remaining = #lines - first + 1
		local take = math.min(remaining, room)
		if take < 1 then
			newPage()
		else
			local chunk = {}
			for i = first, first + take - 1 do chunk[#chunk + 1] = lines[i] end
			ny = ny + fadeLines(chunk,0,ny,r,g,b)
			first = first + take
		end
	end
end
function fadeDoubleNext(v,r,g,b)
	if not big or gpu.getTextWidth(v) * 2 > w then
		fadeNext(v,r,g,b)
		return
	end
	if ny + 24 > h then newPage() end
	ny = ny + fadeDouble(v,0,ny,r,g,b)
end
local function waitNext()
	fadeNext("Click to continue")
	os.pullEvent("monitor_up")
	fadeScreen()
end

function fadeScreen()
	for i=0,255,16 do
		gpu.setColor(255,255,255,i)
		gpu.filledRectangle(0,0,w,h)
		sleep(0)
	end
	gpu.setColor(255,255,255)
	gpu.fill()
	ny = 0
end

