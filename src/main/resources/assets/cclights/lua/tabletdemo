-- tabletdemo: a paint program you control from a tablet.
-- Setup: Tablet Transceiver, a GPU next to it, this computer next to the GPU. Pair a tablet by
-- right clicking the transceiver with it, then right click with the tablet to open the screen.
-- Works on a normal monitor too: every screen sends the same events.
-- usage: tabletdemo [gpu side]
local args = {...}
local gpu = args[1] and peripheral.wrap(args[1]) or peripheral.find("GPU")
if not gpu then
	error("No GPU found. Place one next to the computer or pass its side.", 0)
end
if gpu.reset then gpu.reset() end

local w, h = gpu.getSize(0)
local mon = gpu.getMonitor()
print("Drawing on a " .. (mon and mon.getType and mon.getType() or "screen") .. " of " .. w .. "x" .. h .. " px.")
print("Tap a colour, drag to paint, type to write, tap CLEAR to start over.")
print("Press Q (on the tablet or here) to quit.")

local palette = {
	{ 255, 80, 80 }, { 255, 160, 0 }, { 255, 230, 0 }, { 80, 220, 80 },
	{ 80, 160, 255 }, { 180, 80, 255 }, { 255, 255, 255 }, { 0, 0, 0 },
}
local barH = math.max(12, math.floor(h / 12))
local cell = math.floor(w / (#palette + 1))
local current = 5
local brush = math.max(2, math.floor(h / 72))
local typed = ""
local strokes = {}   -- last position per player/click id

local function color(c, a)
	gpu.setColor(c[1], c[2], c[3], a or 255)
end

local function drawBar()
	gpu.push()
	gpu.origin()
	gpu.resetClip()
	gpu.setColor(40, 40, 50)
	gpu.filledRectangle(0, 0, w, barH)
	for i, c in ipairs(palette) do
		color(c)
		gpu.filledRectangle((i - 1) * cell + 2, 2, cell - 4, barH - 4)
		if i == current then
			gpu.setColor(255, 255, 255)
			gpu.rectangle((i - 1) * cell + 1, 1, cell - 2, barH - 2)
			gpu.setColor(0, 0, 0)
			gpu.rectangle((i - 1) * cell + 2, 2, cell - 4, barH - 4)
		end
	end
	gpu.setColor(120, 40, 40)
	gpu.filledRectangle(#palette * cell + 2, 2, w - #palette * cell - 4, barH - 4)
	gpu.setColor(255, 255, 255)
	local label = "CLEAR"
	gpu.drawText(label, #palette * cell + math.floor((w - #palette * cell - gpu.getTextWidth(label)) / 2), math.floor((barH - 8) / 2))
	gpu.pop()
end

local function drawText()
	gpu.push()
	gpu.origin()
	gpu.resetClip()
	gpu.setColor(40, 40, 50)
	gpu.filledRectangle(0, h - 12, w, 12)
	gpu.setColor(255, 255, 255)
	local s = typed
	while gpu.getTextWidth(s) > w - 8 and #s > 0 do s = s:sub(2) end
	gpu.drawText((typed == "" and "type on the tablet keyboard..." or s), 4, h - 10)
	gpu.pop()
end

local function clear()
	gpu.startFrame()
	gpu.origin()
	gpu.resetClip()
	gpu.setColor(245, 245, 240)
	gpu.fill()
	drawBar()
	drawText()
	gpu.endFrame()
end

clear()
gpu.setLineWidth(brush)
gpu.setAntialias(true)

while true do
	local ev, a, b, c, d = os.pullEvent()
	if ev == "monitor_down" then
		local button, x, y, id = a, b, c, d
		if y < barH then
			local i = math.floor(x / cell) + 1
			if i > #palette then
				clear()
			elseif palette[i] then
				current = i
				drawBar()
			end
		else
			strokes[id] = { x, y }
			gpu.setClip(0, barH, w, h - barH - 12)
			color(palette[current])
			gpu.filledOval(x - brush, y - brush, brush * 2 + 1, brush * 2 + 1)
			gpu.resetClip()
		end
	elseif ev == "monitor_move" then
		local button, x, y, id = a, b, c, d
		local last = strokes[id]
		if last then
			gpu.setClip(0, barH, w, h - barH - 12)
			color(palette[current])
			gpu.line(last[1], last[2], x, y)
			gpu.resetClip()
			last[1], last[2] = x, y
		end
	elseif ev == "monitor_up" then
		strokes[d] = nil
	elseif ev == "monitor_scroll" then
		-- wheel changes the brush size
		brush = math.max(1, math.min(16, brush - c))
		gpu.setLineWidth(brush)
	elseif ev == "char" then
		if a == "q" or a == "Q" then break end
		typed = typed .. a
		drawText()
	elseif ev == "key" and a == 14 then  -- backspace
		typed = typed:sub(1, -2)
		drawText()
	elseif ev == "tablet_image" then
		-- a photo from the tablet becomes the background
		local ok, tex = pcall(gpu.import, a)
		if ok then
			gpu.setColor(255, 255, 255)
			gpu.drawTextureScaled(tex, 0, barH, w, h - barH - 12)
			gpu.freeTexture(tex)
		end
	end
end

gpu.setLineWidth(1)
gpu.setAntialias(false)
gpu.origin()
gpu.setColor(0, 0, 0)
gpu.fill()
print("Bye.")
